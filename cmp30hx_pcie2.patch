+static NvBool
+nv_cmp30hx_is_supported(struct pci_dev *gpu)
+{
+    return (gpu != NULL) &&
+    (gpu->vendor == PCI_VENDOR_ID_NVIDIA) &&
+    (gpu->device == 0x2189);
+}
+
+static void
+nv_cmp30hx_retrain_gen2(nv_state_t *nv)
+{
+    nv_linux_state_t *nvl = NV_GET_NVL_FROM_NV_STATE(nv);
+    struct pci_dev   *gpu = nvl->pci_dev;
+    struct pci_dev   *upstream;
+    void __iomem     *bar0;
+    u16  gpu_ctl2, upstream_ctl2, upstream_ctl, link_status = 0;
+    u32  cya0, link_config, pl_link_rate;
+    int  ret;
+
+    if (!nv_cmp30hx_is_supported(gpu))
+        return;
+
+    upstream = pci_upstream_bridge(gpu);
+    if (!upstream) {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP30_PCIE_GEN2_V2: no upstream bridge\n");
+        return;
+    }
+
+    bar0 = ioremap(pci_resource_start(gpu, 0), 0x90000);
+    if (!bar0) {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP30_PCIE_GEN2_V2: BAR0 map failed\n");
+        return;
+    }
+
+    cya0         = readl(bar0 + 0x8c2c0);
+    link_config  = readl(bar0 + 0x8c040);
+    pl_link_rate = readl(bar0 + 0x8c1c0);
+
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP30_PCIE_GEN2_V2: CYA=%08x(DIS_G2=%u) "
+                  "CFG=%08x(bits[19:18]=%u) "
+                  "PL=%08x(bits[18:17]=%u)\n",
+                  cya0, (cya0 >> 2) & 1U,
+                  link_config, (link_config >> 18) & 3U,
+                  pl_link_rate, (pl_link_rate >> 17) & 3U);
+
+    if (((cya0 & (1U << 2)) != 0U) ||
+        (((link_config  >> 18) & 3U) != 2U) ||
+        (((pl_link_rate >> 17) & 3U) != 2U))
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP30_PCIE_GEN2_V2: GSP policy not ready; retrain skipped\n");
+        iounmap(bar0);
+        return;
+    }
+
+    writel(6U, bar0 + 0x8872c);
+    (void)readl(bar0 + 0x8872c);
+    iounmap(bar0);
+    msleep(50);
+
+    ret = pcie_capability_read_word(gpu,      PCI_EXP_LNKCTL2, &gpu_ctl2);
+    if (ret) goto cap_err;
+    ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL2, &upstream_ctl2);
+    if (ret) goto cap_err;
+
+
+    /*
+     * Multi-attempt Gen2 retrain (v3). On this Intel root port a single
+     * retrain frequently completes at Gen1 despite TLS=5GT on both ends;
+     * repeated retrain pulses inside driver init catch Gen2 (fresh cold
+     * boots demonstrably reach 5GT/s with the same registers). RL is only
+     * ever pulsed from this safe boot context; OS-runtime RL on this
+     * platform kills the link.
+     */
+    {
+        u16 gpu_ctl, v;
+        int pulse, poll_i;
+
+        gpu_ctl2      = (gpu_ctl2      & ~PCI_EXP_LNKCTL2_TLS) | PCI_EXP_LNKCTL2_TLS_5_0GT;
+        upstream_ctl2 = (upstream_ctl2 & ~PCI_EXP_LNKCTL2_TLS) | PCI_EXP_LNKCTL2_TLS_5_0GT;
+
+        for (pulse = 0; pulse < 3; pulse++) {
+            ret = pcie_capability_read_word(gpu, PCI_EXP_LNKCTL2, &v);
+            if (ret) goto cap_err;
+            ret = pcie_capability_write_word(gpu, PCI_EXP_LNKCTL2, gpu_ctl2);
+            if (ret) goto cap_err;
+            ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL2, &v);
+            if (ret) goto cap_err;
+            ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL2, upstream_ctl2);
+            if (ret) goto cap_err;
+
+            if (pulse == 1) {
+                ret = pcie_capability_read_word(gpu, PCI_EXP_LNKCTL, &gpu_ctl);
+                if (ret) goto cap_err;
+                ret = pcie_capability_write_word(gpu, PCI_EXP_LNKCTL,
+                                                 gpu_ctl | PCI_EXP_LNKCTL_RL);
+                if (ret) goto cap_err;
+            } else {
+                ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL, &upstream_ctl);
+                if (ret) goto cap_err;
+                ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL,
+                                                 upstream_ctl | PCI_EXP_LNKCTL_RL);
+                if (ret) goto cap_err;
+            }
+
+            for (poll_i = 0; poll_i < 15; poll_i++) {
+                msleep(100);
+                ret = pcie_capability_read_word(gpu, PCI_EXP_LNKSTA, &link_status);
+                if (!ret &&
+                    ((link_status & PCI_EXP_LNKSTA_CLS) >= PCI_EXP_LNKSTA_CLS_5_0GB))
+                {
+                    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                                  "CMP30_PCIE_GEN2_V2: RETRAIN_PASS status=%04x attempt=%d\n",
+                                  link_status, pulse + 1); /* CMP30_V3FIX */
+                    return;
+                }
+            }
+
+            NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                          "CMP30_PCIE_GEN2_V2: retrain pulse %d failed status=%04x\n",
+                          pulse + 1, link_status);
+        }
+    }
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP30_PCIE_GEN2_V2: RETRAIN_FAIL status=%04x\n", link_status); /* CMP30_V3FIX */
+    return;
+    cap_err:
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP30_PCIE_GEN2_V2: PCI cap error=%d\n", ret);
+}
+
 /*
  * Brings up the device on the first file open. Assumes nvl->ldata_lock is held.
  */
@@ -1521,6 +1659,8 @@
         goto failed_release_irq;
     }
 
+    nv_cmp30hx_retrain_gen2(nv);
+
     /* Generate and cache the UUID for future callers */
     (void)rm_get_gpu_uuid_raw(sp, nv);
 
