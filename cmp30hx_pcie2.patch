+        rb_lnkcfg  = GPU_REG_RD32(pGpu, 0x0008c040U);
+        rb_pl_rate = GPU_REG_RD32(pGpu, 0x0008c1c0U);
+
+        NV_PRINTF(LEVEL_ERROR,
